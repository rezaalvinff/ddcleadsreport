# DIPO Lead Handover — copy to .env.local for local development and add the
# same variables in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Only NEXT_PUBLIC_* values are visible to browsers.

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Login allowlist ---------------------------------------------------------
# Comma-separated emails of Supabase Auth users allowed to use the app.
ALLOWED_EMAILS=

# --- Google Sheets (service account) -----------------------------------------
# ID from https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the service-account JSON key, including the
# BEGIN/END lines. Literal \n sequences are converted to newlines.
GOOGLE_PRIVATE_KEY=

# --- Gemini (optional fallback for unknown domicile texts) -------------------
GEMINI_API_KEY=
# Example: gemini-2.5-flash-lite. Check availability and free-tier eligibility
# at https://ai.google.dev/gemini-api/docs/pricing, then use Pengaturan → "Cek model".
GEMINI_MODEL=

# --- Automatic retry of failed Google Sheets syncs (Vercel Cron) -------------
# Random string of at least 16 characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
