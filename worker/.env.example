# Salin file ini jadi worker/.env lalu isi dua baris pertama.
# File .env tidak ikut ter-commit.

# Alamat aplikasi di Vercel, tanpa garis miring di akhir.
APP_URL=

# Harus sama persis dengan WA_WORKER_SECRET di Environment Variables Vercel.
WA_WORKER_SECRET=

# Opsional — biarkan kosong kalau tidak yakin.
# WA_POLL_SECONDS=8
# WA_BATCH=5
# WA_GAP_SECONDS=4
